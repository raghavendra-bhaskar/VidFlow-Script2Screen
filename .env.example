# ── FULLY OFFLINE MODE (no keys required) ─────────────────────────────────────
# Choose "Animated explainer" in the UI — the app uses pyttsx3 (Windows/macOS/Linux
# system TTS) for narration and Pillow for scene cards. Only FFmpeg is needed.
# Leave every key below blank or commented out to use this mode.

# ── OPTIONAL: Google Cloud TTS (Indian English neural voices + pitch control) ──
# 1. Enable Cloud Text-to-Speech in Google Cloud Console.
# 2. Create a service account, download its JSON key.
# 3. Set the path below to that file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ── OPTIONAL: Gemini image generation (AI-generated scenes mode) ───────────────
# Get a key from https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── OPTIONAL: Pexels stock footage (Stock footage mode) ───────────────────────
# Request a key from https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# ── VM / Kubernetes deployment settings ───────────────────────────────────────
# OLLAMA_BASE_URL : URL the VidFlow process uses to reach Ollama.
#                   Local install: http://localhost:11434
#                   Container install: use the VM/private-service address reachable
#                   from the app container, e.g. http://10.0.0.10:11434.
OLLAMA_BASE_URL=http://localhost:11434

# VIDFLOW_DOMAIN   : hostname(s) to add to the self-signed TLS cert (comma-separated).
#                    Set before running gen_cert.py on the VM.
#                    Example: VIDFLOW_DOMAIN=hclswl2learninghub,10.225.16.145
VIDFLOW_DOMAIN=

# VIDFLOW_INTERNAL_BASE_URL : Optional complete URL the browser uses for the trim and
#                             recording API, e.g. https://vidflow.example.com/api.
#                             Leave blank to use VIDFLOW_INTERNAL_HOST/PORT below.
VIDFLOW_INTERNAL_BASE_URL=

# VIDFLOW_INTERNAL_HOST : hostname/IP that the *browser* uses to reach the internal
#                         API server. Leave blank for localhost (single-machine dev).
VIDFLOW_INTERNAL_HOST=

# VIDFLOW_INTERNAL_PORT : Port for the internal API server. Default 8502.
VIDFLOW_INTERNAL_PORT=8502

# VIDFLOW_INTERNAL_BIND : Interface for the internal server to bind to.
#                         Keep 127.0.0.1 for a native VM install; use 0.0.0.0 in containers.
VIDFLOW_INTERNAL_BIND=127.0.0.1
